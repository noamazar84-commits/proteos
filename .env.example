# Transactional verification email (Resend)
RESEND_API_KEY=
VERIFICATION_FROM_EMAIL=Proteus <verify@example.com>
PUBLIC_APP_ORIGIN=https://your-proteus-domain.example

# Optional secure Whop customer billing-management URL shown in Account Settings.
